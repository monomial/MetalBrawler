# Xcode
*.xcworkspace
*.xcuserdata
xcuserdata/
DerivedData/
.build/
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Build artifacts
build/

# Intermediate icon staging — PNGs are copied into xcassets; regenerate with tools/generate_icons.py
icon_output/

# Source assets — not needed at runtime; regenerate with tools/convert_to_usdz.py
assets/characters/player/*.fbx
assets/characters/player/unused/

# Downloaded third-party audio packs — re-download from kenney.nl if needed.
# Curated game-ready files (sfx_*.wav, music_battle.mp3) are tracked via LFS instead.
assets/audio/kenney_impact-sounds/
assets/characters/enemy/*.fbx
assets/characters/enemy/unused/
